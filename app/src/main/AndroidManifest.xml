<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- Android 13+ (API 33+): required for the playback notification to appear in
         the notification shade when pulling down. Without it the media controls may
         show on the lock screen but be hidden in the shade. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- The app is usable on Android Automotive OS / Android Auto head units but does
         not require it; a phone-only install remains fully functional. -->
    <uses-feature
        android:name="android.hardware.type.automotive"
        android:required="false" />

    <application
        android:name=".StArchiveApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.StArchivePlayer"
        tools:targetApi="35">

        <!-- Declares this app as an Android Auto / Automotive media app. -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />

        <!-- Google Cast options provider (phone casting only). -->
        <meta-data
            android:name="com.google.android.gms.cast.framework.OPTIONS_PROVIDER_CLASS_NAME"
            android:value="com.starchive.player.playback.CastOptionsProvider" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.StArchivePlayer">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Media3 MediaLibraryService: background playback, lock-screen / notification
             controls, and the browsable media tree (Artists / Favorites / Search History)
             that Android Auto and the Google Assistant use to browse and voice-launch
             playback ("play artist X", "play favorites"). -->
        <service
            android:name=".playback.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
                <action android:name="androidx.media3.session.MediaLibraryService" />
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>
    </application>
</manifest>
