<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- Android 13+ (API 33+): required for the playback notification to appear in
         the notification shade when pulling down. Without it the media controls may
         show on the lock screen but be hidden in the shade. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Host-rendered Android Auto media app: the media browser host must be optional so the
         app still distributes to phones that don't have Android Auto. -->
    <uses-feature
        android:name="android.software.car.templates_host.media"
        android:required="false" />

    <!-- Android 11+ package visibility: we need to resolve the default browser
         so About links can be opened with an explicit browser component. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:name=".StArchiveApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.StArchivePlayer"
        tools:targetApi="35">

        <!-- Google Cast options provider (phone casting only). -->
        <meta-data
            android:name="com.google.android.gms.cast.framework.OPTIONS_PROVIDER_CLASS_NAME"
            android:value="com.starchive.player.playback.CastOptionsProvider" />

        <!-- Android Auto: declare this app as a host-rendered media app. -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.StArchivePlayer">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Media3 MediaLibraryService: background playback + lock-screen / notification
             controls on the phone, plus the browse tree / session for Android Auto. -->
        <service
            android:name=".playback.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
                <action android:name="androidx.media3.session.MediaLibraryService" />
                <!-- Android Auto / AAOS discover media apps through the platform browser
                     action; the media3 actions alone are not always enough for discovery. -->
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>

        <!-- Home-screen mini-player widget (drives the same PlaybackService MediaLibrarySession). -->
        <receiver
            android:name=".widget.StArchiveWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.starchive.player.widget.UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/mini_player_widget_info" />
        </receiver>
    </application>
</manifest>